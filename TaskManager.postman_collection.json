{
  "info": {
    "name": "Task Manager — Data JPA",
    "description": "Выполнить по порядку после перезапуска приложения. baseUrl уже заполнен.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Пустой список после запуска",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const responseData = pm.response.json(); const tasks = Array.isArray(responseData) ? responseData : responseData.content;",
              "pm.test(\"Пустой список\", () => pm.expect(tasks).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Создать: Купить молоко",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Купить молоко\",\n  \"description\": \"Список покупок\",\n  \"priority\": \"LOW\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const task = pm.response.json();",
              "pm.collectionVariables.set(\"firstId\", String(task.id));",
              "pm.test(\"Создана задача с числовым id\", () => pm.expect(task.id).to.be.a(\"number\"));",
              "pm.test(\"Начальный статус NEW\", () => pm.expect(task.status).to.equal(\"NEW\"));",
              "pm.collectionVariables.set(\"firstCreatedAt\", task.createdAt);"
            ]
          }
        }
      ]
    },
